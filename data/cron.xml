<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ir_cron_carry_forward_allocations" model="ir.cron">
            <field name="name">Time Off: Create Yearly Carry Forward Allocations</field>
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_carry_forward_allocations()</field>
            <field name="nextcall" eval="(DateTime.today().replace(month=1, day=1) + relativedelta(years=1)).strftime('%Y-%m-%d 00:00:00')"/>
        </record>

        <record id="ir_cron_carry_forward_allocations_per_employee" model="ir.cron">
            <field name="name">Time Off: Create Yearly Carry Forward Allocations (Per Employee)</field>
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_carry_forward_allocations_per_employee()</field>
            <field name="nextcall" eval="(DateTime.today().replace(month=1, day=1) + relativedelta(years=1)).strftime('%Y-%m-%d 00:00:00')"/>
        </record>

    </data>
</odoo>
